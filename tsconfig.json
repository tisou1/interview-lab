{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": { "@/*": ["./src/*"] },
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node", "@testing-library/jest-dom"]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
