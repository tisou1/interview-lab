{
  "name": "frontend-interview-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content": "node scripts/build-question-data.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm content && pnpm typecheck && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deps:check": "taze latest --include-locked --exclude pnpm --force --fail-on-outdated --request-timeout 30000 --concurrency 4",
    "deploy": "pnpm build && gh-pages -d dist"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "taze": "^21.1.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
